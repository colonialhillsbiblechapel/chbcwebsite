{
  "name": "chbc-website",
  "description": "Colonial Hills Bible Chapel website (Astro)",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:third-party && npm run check:licenses",
    "preview": "astro preview",
    "check": "astro check",
    "check:third-party": "node scripts/check-third-party.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run knip && npm run build && npm run test:e2e",
    "astro": "astro",
    "thumbnails": "node scripts/fetch-thumbnails.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "preact": "^11.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
