---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** A wide photograph at its natural proportions, in a fine frame, with a museum-style caption. */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  kind?: string;
  class?: string;
}

const { src, alt, caption, kind = 'Our chapel', class: className } = Astro.props;
---

<figure class:list={['reveal', className]}>
  <div class="relative overflow-hidden bg-paper-shade shadow-[0_30px_60px_-40px_rgb(23_20_15/0.5)]">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      layout="full-width"
      sizes="(min-width: 1440px) 85rem, 100vw"
      pictureAttributes={{ class: 'block' }}
      class="h-auto w-full"
    />
    <div
      class="pointer-events-none absolute inset-2.5 border border-white/55 sm:inset-3"
      aria-hidden="true"
    ></div>
  </div>
  <figcaption class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="h-px w-8 bg-gold" aria-hidden="true"></span>
    <span class="label whitespace-nowrap">{kind}</span>
    <span class="font-display text-[1.05rem] text-muted italic">{caption}</span>
  </figcaption>
</figure>
