---
interface Props {
  size?: 'md' | 'lg';
  class?: string;
}
const { size = 'md', class: className } = Astro.props;
// On narrow phones the name sits on two balanced lines rather than wrapping on its own.
const line = size === 'lg' ? 'block min-[480px]:inline' : 'block min-[400px]:inline';
---

<span class:list={['flex items-center gap-3', className]}>
  {/* The chapel's initials as a plain monogram, matching the favicon: no symbol, just the name. */}
  <span
    class:list={[
      size === 'lg'
        ? 'size-12 text-[1.55rem]'
        : 'size-9 text-[1.15rem] sm:size-10 sm:text-[1.3rem]',
      'grid shrink-0 place-items-center rounded-[22%] bg-ink font-display leading-none font-semibold tracking-[-0.03em] text-paper',
    ]}
    aria-hidden="true"
  >
    <span class="translate-y-[0.03em]">CH</span>
  </span>
  <span
    class:list={[
      'font-display leading-[1.05] tracking-[0.005em] text-ink',
      size === 'lg' ? 'text-[1.7rem]' : 'text-[1.2rem] sm:text-[1.4rem]',
    ]}
  >
    <span class={line}>Colonial Hills</span> <span class={line}>Bible Chapel</span>
  </span>
</span>
