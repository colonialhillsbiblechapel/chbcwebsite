---
/**
 * A YouTube video that loads only when the visitor presses play.
 * Until then nothing is requested from YouTube or Google: the poster is one of our own
 * photographs. The player is YouTube's privacy-enhanced (youtube-nocookie.com) embed.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  youtubeId: string;
  /** Accessible title of the video, also used for the iframe. */
  title: string;
  poster: ImageMetadata;
  /** Who made the video, credited under the player. */
  credit?: { name: string; url: string };
  class?: string;
}

const { youtubeId, title, poster, credit, class: className } = Astro.props;
---

<figure class:list={['reveal', className]}>
  <div
    class="relative aspect-video overflow-hidden bg-ink shadow-[0_40px_80px_-40px_rgb(23_20_15/0.6)]"
    data-video={youtubeId}
    data-video-title={title}
  >
    <button
      type="button"
      class="group absolute inset-0 size-full"
      aria-label={`Play video: ${title}`}
    >
      <Picture
        src={poster}
        alt=""
        formats={['avif', 'webp']}
        layout="full-width"
        sizes="(min-width: 1440px) 49rem, (min-width: 1024px) 53vw, 100vw"
        fit="cover"
        pictureAttributes={{ class: 'block size-full' }}
        class="size-full object-cover transition-transform duration-[1.6s] ease-gentle group-hover:scale-[1.03]"
      />
      <span class="absolute inset-0 bg-ink/25 transition-colors duration-500 group-hover:bg-ink/15"></span>
      <span class="absolute top-1/2 left-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-paper/90 shadow-[0_12px_40px_-12px_rgb(0_0_0/0.6)] transition-transform duration-500 ease-gentle group-hover:scale-105 sm:size-24">
        <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-ink sm:size-8" aria-hidden="true">
          <path d="M7 4.5v15l12.5-7.5L7 4.5Z"></path>
        </svg>
      </span>
    </button>
  </div>
  <figcaption class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.95rem] text-muted">
    <span class="h-px w-8 bg-gold" aria-hidden="true"></span>
    <span>Plays from YouTube in privacy-enhanced mode.</span>
    {credit && (
      <span>
        Video by{' '}
        <a href={credit.url} target="_blank" rel="noopener noreferrer" class="text-link">
          {credit.name}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        .
      </span>
    )}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.videoTitle ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 size-full';
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
