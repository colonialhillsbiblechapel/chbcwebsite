---
/** A titled block of running text: the title sits in the left column, the text on the right. */
interface Props {
  title: string;
}

const { title } = Astro.props;
const id = `section-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
  class="reveal grid gap-6 border-t border-rule pt-10 lg:grid-cols-12 lg:gap-10"
  aria-labelledby={id}
>
  <h2 id={id} class="text-[2rem] leading-tight lg:col-span-4">
    {title}
  </h2>
  <div class="prose-chapel max-w-2xl text-ink-soft lg:col-span-7 lg:col-start-6">
    <slot />
  </div>
</section>
