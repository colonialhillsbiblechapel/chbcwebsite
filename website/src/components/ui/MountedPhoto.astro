---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A photograph mounted like a print: on a light mat with a hairline edge and a soft shadow,
 * with a small caption beneath. Shown whole unless `height` asks for a crop.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Display width in pixels (a 2× version is made for sharp screens). */
  width: number;
  /** Crop to this height; the photo keeps its own proportions when left out. */
  height?: number;
  /** Focal point for a crop, e.g. "top". */
  position?: string;
  sizes: string;
  /** Small caps word before the caption, e.g. "Local ministry". */
  label?: string;
  caption?: string;
  class?: string;
}

const { src, alt, width, height, position, sizes, label, caption, class: className } = Astro.props;
---

<figure class:list={['reveal m-0', className]}>
  <div class="border border-rule bg-white p-3 shadow-[0_30px_60px_-36px_rgb(23_20_15/0.45)] sm:p-4">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      width={width}
      height={height}
      fit={height ? 'cover' : undefined}
      position={position}
      sizes={sizes}
      pictureAttributes={{ class: 'block bg-paper-shade' }}
      class="block h-auto w-full"
    />
  </div>
  {caption && (
    <figcaption class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="h-px w-8 bg-gold" aria-hidden="true" />
      {label && <span class="label whitespace-nowrap">{label}</span>}
      <span class="font-display text-[1.05rem] text-muted italic">{caption}</span>
    </figcaption>
  )}
</figure>
