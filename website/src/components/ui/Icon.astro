---
import type { IconName } from '@/config/icons';

/** A line icon (Phosphor Icons, MIT), drawn inline in the current text color. Decorative. */
interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const files = import.meta.glob<{ default: (props: Record<string, unknown>) => unknown }>(
  '/src/assets/icons/*.svg',
  { eager: true },
);
const Svg = files[`/src/assets/icons/${name}.svg`]?.default;
if (!Svg) throw new Error(`Missing icon src/assets/icons/${name}.svg`);
---

<Svg class:list={['shrink-0', className]} aria-hidden="true" focusable="false" />
