---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'ink' | 'paper';
  /** Adds a trailing arrow. */
  arrow?: boolean;
  external?: boolean;
};

const {
  href,
  variant = 'ink',
  arrow = false,
  external = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex min-h-13 items-center justify-center gap-3 px-6 py-4 text-center text-[0.78rem] leading-tight font-medium tracking-[0.22em] sm:px-7 sm:tracking-[0.28em] uppercase transition-colors duration-500 ease-gentle',
    variant === 'ink'
      ? 'bg-ink text-paper hover:bg-[#2b261d]'
      : 'bg-paper text-ink ring-1 ring-rule ring-inset hover:ring-ink/40',
    className,
  ]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...rest}
>
  <slot />
  {arrow && (
    <span
      aria-hidden="true"
      class="inline-block font-display text-base tracking-normal transition-transform duration-500 ease-gentle group-hover:translate-x-1"
    >
      →
    </span>
  )}
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
