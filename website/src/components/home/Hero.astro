---
import { Picture } from 'astro:assets';
import sanctuary from '@/assets/images/home/sanctuary.jpg';
import Button from '../ui/Button.astro';
import { getMeetings } from '@/lib/data';
import { formatTime } from '@/lib/format';
import { describeSlot, meetingSlots } from '@/lib/schedule';

const slots = meetingSlots(await getMeetings());
const first = slots[0];
---

<section
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden"
  aria-labelledby="hero-title"
>
  <!--
    The chapel's own meeting room. Phones: a band across the top. Wide screens: a panel on the
    right that dissolves into the paper, keeping the gold lettering clear of the headline.
  -->
  <figure class="absolute inset-x-0 top-20 -z-10 m-0 h-[46svh] overflow-hidden lg:top-24 lg:right-0 lg:bottom-0 lg:left-auto lg:h-auto lg:w-[62%]">
    <Picture
      src={sanctuary}
      alt="The meeting room of Colonial Hills Bible Chapel: rows of wooden pews facing a green plank wall lettered in gold, “The gift of God is eternal life through Jesus Christ our Lord”."
      formats={['avif', 'webp']}
      layout="full-width"
      sizes="(min-width: 1024px) 62vw, 100vw"
      fit="cover"
      priority
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover object-[40%_top]"
    />
    <div aria-hidden="true">
      <div class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-paper via-paper/60 to-transparent lg:hidden"></div>
      <div class="absolute inset-y-0 left-0 hidden w-2/5 bg-linear-to-r from-paper via-paper/60 to-transparent lg:block"></div>
      <div class="absolute inset-x-0 bottom-0 hidden h-40 bg-linear-to-t from-paper to-transparent lg:block"></div>
    </div>
  </figure>

  <div class="mx-auto flex w-full max-w-[90rem] flex-1 flex-col justify-end px-5 pt-[calc(46svh+5rem)] pb-12 sm:px-10 lg:justify-center lg:pt-36 lg:pb-16">
    <div class="max-w-3xl animate-rise">
      <p class="label">Welcome to</p>
      <h1 id="hero-title" class="mt-8 text-hero">
        Colonial Hills
        <br />
        <em class="italic">Bible Chapel</em>
      </h1>
      <figure class="mt-10 max-w-xl">
        <blockquote class="font-display text-[1.6rem] leading-snug text-ink-soft italic">
          <p>
            “For God so loved the world that He gave His only begotten Son, that whoever believes in
            Him should not perish but have everlasting life.”
          </p>
        </blockquote>
        <figcaption class="label mt-4">John 3:16 · NKJV</figcaption>
      </figure>
      <div class="mt-11 flex flex-wrap gap-3">
        <Button href="/#visit" arrow>
          Plan your visit
        </Button>
        <Button href="/gospel/" variant="paper">
          The Gospel
        </Button>
      </div>
    </div>
  </div>

  <div class="mx-auto flex w-full max-w-[90rem] items-end justify-between gap-6 px-5 pb-8 sm:px-10">
    {first && (
      <p
        class="flex flex-wrap items-baseline gap-x-4 gap-y-2"
        data-schedule={JSON.stringify(slots)}
      >
        <span class="label">Next gathering</span>
        <span class="font-display text-[1.2rem] text-ink" data-next-gathering>
          {describeSlot(first, first.day, formatTime)}
        </span>
      </p>
    )}
    <div class="hidden shrink-0 items-center gap-6 lg:flex">
      <span class="font-display text-[1.05rem] text-muted italic">
        Our meeting room on Henry Road
      </span>
      <a href="#welcome" class="label flex flex-col items-center gap-3 text-ink-soft">
        Read
        <span class="relative h-12 w-px overflow-hidden bg-ink/15" aria-hidden="true">
          <span class="absolute inset-x-0 top-0 h-1/2 animate-[scroll-cue_2.4s_ease-in-out_infinite] bg-ink/70"></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes scroll-cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(200%);
    }
  }
</style>

<script>
  import { formatTime } from '@/lib/format';
  import { describeSlot, nextSlot, whenLabel, type Slot } from '@/lib/schedule';

  // Replace the static "next gathering" with the real next one, in Houston time.
  const holder = document.querySelector<HTMLElement>('[data-schedule]');
  const target = document.querySelector<HTMLElement>('[data-next-gathering]');
  const next = holder && nextSlot(JSON.parse(holder.dataset.schedule ?? '[]') as Slot[]);
  if (target && next) {
    target.textContent = describeSlot(
      next.slot,
      whenLabel(next.daysAway, next.slot.day),
      formatTime,
    );
  }
</script>
