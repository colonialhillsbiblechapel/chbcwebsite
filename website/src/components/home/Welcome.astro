---
import sanctuary from '@/assets/images/home/sanctuary.jpg';
import Button from '../ui/Button.astro';
import VideoFacade from '../ui/VideoFacade.astro';
import { getPage } from '@/lib/data';

const welcome = await getPage('welcome');
---

<section
  id="welcome"
  class="relative isolate overflow-hidden py-28 lg:py-40"
  aria-labelledby="welcome-title"
>
  <!-- A soft wash of morning light -->
  <div
    class="pointer-events-none absolute -top-40 right-0 -z-10 size-[48rem] rounded-full bg-[radial-gradient(closest-side,rgb(226_201_143/0.3),transparent)]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-[90rem] gap-16 px-5 sm:px-10 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="label reveal">Welcome</p>
      <h2
        id="welcome-title"
        class="reveal mt-7 font-display text-[clamp(3rem,1.9rem+4vw,5.5rem)] leading-[0.98] text-ink"
      >
        {welcome.title}
      </h2>
      <div class="prose-chapel first-drop-cap reveal mt-10 text-[1.15rem] text-ink-soft">
        <welcome.Content />
      </div>
      <div class="reveal mt-10 flex flex-wrap gap-3">
        <Button href="#services" arrow>
          Meeting times
        </Button>
        <Button href="/about/" variant="paper">
          About us
        </Button>
      </div>
    </div>

    <div class="lg:col-span-7 lg:pt-24">
      <div class="lg:sticky lg:top-32">
        <VideoFacade
          youtubeId="J-lXFELzsIA"
          title="Welcome to our church"
          poster={sanctuary}
          credit={{ name: 'Centerline Studios', url: 'https://www.youtube.com/@centerlinestudios' }}
        />
      </div>
    </div>
  </div>
</section>
