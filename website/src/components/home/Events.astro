---
import SectionHeading from '../ui/SectionHeading.astro';
import { getUpcomingEvents } from '@/lib/data';
import { dayOfMonth, monthShort, weekday } from '@/lib/dates';
import { formatTimeRange } from '@/lib/format';

const events = await getUpcomingEvents();
---

<section id="events" class="border-y border-rule bg-paper-deep" aria-labelledby="events-title">
  <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-28 sm:px-10 lg:grid-cols-12 lg:gap-10 lg:py-40">
    <div class="lg:col-span-4">
      <SectionHeading
        id="events-title"
        label="In the weeks ahead"
        title="Special Events &"
        emphasis="Announcements"
      />
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      <ol class="border-t border-rule" data-events>
        {events.map((event) => (
          <li
            class="reveal grid grid-cols-[5.5rem_minmax(0,1fr)] gap-6 border-b border-rule py-9 sm:grid-cols-[7rem_minmax(0,1fr)]"
            data-last-day={event.lastDay}
          >
            <p class="text-center">
              <span class="gilded block font-display text-[3.6rem] leading-[0.9]">
                {dayOfMonth(event.date)}
              </span>
              <span class="label mt-2 block">{monthShort(event.date)}</span>
            </p>
            <div>
              <h3 class="text-[1.85rem] leading-tight">{event.title}</h3>
              <p class="mt-2 text-[0.8rem] tracking-[0.12em] text-gold-ink uppercase">
                {weekday(event.date)}
                {event.start && <> · {formatTimeRange(event.start, event.end)}</>}
                {event.location && <> · {event.location}</>}
              </p>
              {event.summary && <p class="mt-3 text-muted">{event.summary}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p
        class="reveal border-b border-rule py-9 font-display text-[1.5rem] text-muted italic"
        data-events-empty
        hidden={events.length > 0}
      >
        No special events are planned just now — we would love to see you at our regular meetings.
      </p>
    </div>
  </div>
</section>

<script>
  // If the nightly rebuild hasn't run yet, hide events whose last day has passed (Houston time).
  import { todayInHouston } from '@/lib/dates';

  const today = todayInHouston();
  const items = document.querySelectorAll<HTMLElement>('[data-events] [data-last-day]');
  let shown = 0;
  items.forEach((item) => {
    const past = (item.dataset.lastDay ?? '') < today;
    item.hidden = past;
    if (!past) shown++;
  });
  const empty = document.querySelector<HTMLElement>('[data-events-empty]');
  if (empty) empty.hidden = shown > 0;
</script>
