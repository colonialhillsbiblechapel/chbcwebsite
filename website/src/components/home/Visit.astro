---
import { Picture } from 'astro:assets';
import sign from '@/assets/images/about/bottom.jpg';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { cityLine, directionsLinks, getSettings } from '@/lib/data';
import { telHref } from '@/lib/format';

const settings = await getSettings();
const directions = directionsLinks(settings.address);
---

<section
  id="visit"
  class="relative isolate border-y border-rule bg-paper-deep"
  aria-labelledby="visit-title"
>
  <!-- Phones: a band above the text. Wide screens: the right half, dissolving into the page. -->
  <figure class="m-0 h-[40svh] fade-bottom lg:absolute lg:inset-y-0 lg:right-0 lg:z-0 lg:h-auto lg:w-[46%] lg:fade-left">
    <Picture
      src={sign}
      alt="The Colonial Hills Bible Chapel sign under a clear blue sky"
      formats={['avif', 'webp']}
      layout="full-width"
      sizes="(min-width: 1024px) 46vw, 100vw"
      fit="cover"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </figure>
  <div class="relative mx-auto grid max-w-[90rem] px-5 pb-28 sm:px-10 lg:grid-cols-12 lg:py-40">
    <div class="lg:col-span-6">
      <SectionHeading
        id="visit-title"
        label="Contact information"
        title="Visit us this Sunday at"
        emphasis="9:30 AM"
      />

      <dl class="reveal mt-12 grid gap-x-10 gap-y-8 border-t border-rule pt-10 sm:grid-cols-2">
        <div>
          <dt class="label">Address</dt>
          <dd class="mt-3 font-display text-[1.35rem] leading-snug text-ink">
            {settings.address.street}
            <br />
            {cityLine(settings.address)}
          </dd>
        </div>
        <div>
          <dt class="label">Telephone</dt>
          <dd class="mt-3 font-display text-[1.35rem] text-ink">
            <a href={telHref(settings.phone)} class="hover:text-gold-ink">
              {settings.phone}
            </a>
          </dd>
          <dt class="label mt-7">Email</dt>
          <dd class="mt-3 text-[1.05rem] break-words text-ink">
            <a href={`mailto:${settings.email}`} class="text-link">
              {settings.email}
            </a>
          </dd>
        </div>
      </dl>

      <div class="reveal mt-12 flex flex-wrap gap-3">
        <Button href={directions.google} external arrow>
          Google Maps
        </Button>
        <Button href={directions.apple} external variant="paper">
          Apple Maps
        </Button>
      </div>
    </div>
  </div>
</section>
