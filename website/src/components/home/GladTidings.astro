---
import { Picture } from 'astro:assets';
import gospelHero from '@/assets/images/photos/gospel-hero.jpg';
import Button from '../ui/Button.astro';
import Scripture from '../ui/Scripture.astro';
---

<section class="relative isolate border-t border-rule" aria-labelledby="gospel-title">
  <!-- Phones: a band above the text. Wide screens: the left half, dissolving into the page. -->
  <figure class="m-0 h-[42svh] fade-bottom lg:absolute lg:inset-y-0 lg:left-0 lg:-z-10 lg:h-auto lg:w-[50%] lg:fade-right">
    <Picture
      src={gospelHero}
      alt="Sunrise over a stone path winding through an old olive garden"
      formats={['avif', 'webp']}
      layout="full-width"
      sizes="(min-width: 1024px) 50vw, 100vw"
      fit="cover"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class="h-full w-full object-cover"
    />
  </figure>
  <div class="mx-auto grid max-w-[90rem] px-5 pb-28 sm:px-10 lg:grid-cols-12 lg:py-44">
    <div class="lg:col-span-6 lg:col-start-7">
      <h2 id="gospel-title" class="label reveal">
        The Gospel
      </h2>
      <Scripture
        class="mt-10"
        text="The gift of God is eternal life through Jesus Christ our Lord."
        reference="Romans 6:23"
        translation="KJV"
      />
      <Button href="/gospel/" arrow class="reveal mt-10">
        Read the Gospel
      </Button>
    </div>
  </div>
</section>
