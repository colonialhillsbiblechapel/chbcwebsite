---
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { kindLabel } from '@/components/media/library';
import { getMediaLibrary } from '@/lib/media';

// The newest messages, whatever they are — updated automatically from the YouTube channel.
const recent = (await getMediaLibrary()).filter((i) => i.date).slice(0, 3);
---

<section class="mx-auto max-w-[90rem] px-5 py-28 sm:px-10 lg:py-40" aria-labelledby="word-title">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <SectionHeading id="word-title" label="Media" title="Recent" emphasis="Messages" />
    <Button href="/media/" arrow class="reveal self-start lg:self-auto">
      The media library
    </Button>
  </div>

  <ul class="mt-14 grid gap-x-8 gap-y-12 lg:grid-cols-3">
    {recent.map((message) => (
      <li class="reveal">
        <a
          href={`/media/?v=${message.id}`}
          class="group block md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-center md:gap-8 lg:block"
        >
          <span class="relative block aspect-video overflow-hidden bg-paper-shade shadow-[0_24px_48px_-32px_rgb(23_20_15/0.55)]">
            {message.thumbnail && (
              <picture class="block size-full">
                <source
                  type="image/avif"
                  srcset={message.thumbnail.avif}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 42vw, 92vw"
                />
                <source
                  type="image/webp"
                  srcset={message.thumbnail.webp}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 42vw, 92vw"
                />
                <img
                  src={message.thumbnail.src}
                  alt=""
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-[1.4s] ease-gentle group-hover:scale-[1.04]"
                />
              </picture>
            )}
            <span class="absolute bottom-3 left-3 flex size-11 items-center justify-center rounded-full bg-paper/92 shadow-lg">
              <svg viewBox="0 0 24 24" class="ml-0.5 size-4 fill-ink" aria-hidden="true">
                <path d="M7 4.5v15l12.5-7.5L7 4.5Z" />
              </svg>
            </span>
          </span>
          <span class="block">
            <span class="label mt-5 block md:mt-0 lg:mt-5">
              {kindLabel(message)} · {message.dateLabel}
            </span>
            <span class="mt-2 block font-display text-[1.6rem] leading-snug text-ink transition-colors group-hover:text-gold-ink">
              {message.title}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
