---
import Wordmark from '../ui/Wordmark.astro';
import { primaryNav, visitLink, isCurrent } from '@/config/site';
import { cityLine, getSettings } from '@/lib/data';
import { telHref, toRoman } from '@/lib/format';

const path = Astro.url.pathname;
const settings = await getSettings();
const menuLinks = [{ label: 'Home', href: '/' }, ...primaryNav, visitLink];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b print:hidden border-transparent transition-[background-color,border-color] duration-500 ease-gentle data-scrolled:border-rule/70 data-scrolled:bg-paper"
>
  <div class="mx-auto flex h-20 max-w-[90rem] items-center justify-between gap-4 px-5 sm:px-10 lg:h-24">
    <a href="/" class="py-2" aria-label={`${settings.name} — home`}>
      <Wordmark />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 xl:gap-10">
        {[...primaryNav, visitLink].map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href, path) && link !== visitLink ? 'page' : undefined}
              class="relative block py-3 text-[0.75rem] font-medium tracking-[0.24em] text-ink-soft uppercase transition-colors duration-300 after:absolute after:inset-x-0 after:bottom-1.5 after:h-px after:origin-left after:scale-x-0 after:bg-gold after:transition-transform after:duration-500 after:ease-gentle hover:text-ink hover:after:scale-x-100 aria-[current=page]:text-ink aria-[current=page]:after:scale-x-100"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex size-12 items-center justify-center text-ink lg:hidden"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <svg
        viewBox="0 0 28 28"
        class="size-7"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        aria-hidden="true"
      >
        <path d="M4 10h20M4 18h20"></path>
      </svg>
    </button>
  </div>
</header>

<dialog
  id="mobile-menu"
  aria-label="Site menu"
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto bg-paper p-0 text-ink-soft backdrop:bg-transparent open:animate-fade"
>
  <div class="flex min-h-full flex-col">
    <div class="flex h-20 items-center justify-between px-5 sm:px-10">
      <a href="/" class="py-2" aria-label={`${settings.name} — home`}>
        <Wordmark />
      </a>
      <button
        type="button"
        class="-mr-2 inline-flex size-12 items-center justify-center text-ink"
        aria-label="Close menu"
        data-menu-close
      >
        <svg
          viewBox="0 0 28 28"
          class="size-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          aria-hidden="true"
        >
          <path d="M7 7l14 14M21 7L7 21"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Main" class="px-5 pt-6 sm:px-10">
      <ul class="border-t border-rule">
        {menuLinks.map((link, i) => (
          <li class="border-b border-rule">
            <a
              href={link.href}
              aria-current={isCurrent(link.href, path) && link !== visitLink ? 'page' : undefined}
              class="flex items-baseline gap-5 py-4 font-display text-[2.1rem] leading-tight text-ink aria-[current=page]:italic"
            >
              <span class="gilded w-10 shrink-0 text-xl" aria-hidden="true">
                {toRoman(i + 1)}
              </span>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto px-5 py-10 sm:px-10">
      <p class="label">Visit us</p>
      <p class="mt-4 text-lg leading-snug text-ink">
        {settings.address.street}
        <br />
        {cityLine(settings.address)}
      </p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        <a href={telHref(settings.phone)} class="text-link py-1">
          {settings.phone}
        </a>
        <a href={`mailto:${settings.email}`} class="text-link py-1">
          Email us
        </a>
      </p>
    </div>
  </div>
</dialog>

<script>
  const header = document.getElementById('site-header');
  const setScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && openButton) {
    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    menu.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
