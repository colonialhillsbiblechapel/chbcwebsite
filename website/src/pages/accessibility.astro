---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import TextSection from '@/components/ui/TextSection.astro';
import { getSettings } from '@/lib/data';
import { telHref } from '@/lib/format';

const settings = await getSettings();
---

<BaseLayout
  title="Accessibility"
  description="How we make the Colonial Hills Bible Chapel website usable by everyone: the standard we aim for, known limitations, and how to report a problem."
>
  <PageHero
    label="Accessibility · Last reviewed October 2026"
    title="A website for"
    emphasis="everyone."
    lede="We want everyone to be able to read, listen, watch and find their way around this site, whatever device or assistive technology they use."
  />

  <div class="mx-auto max-w-[90rem] space-y-16 px-5 pb-28 sm:px-10 lg:pb-40">
    <TextSection title="Our standard">
      <p>
        We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at Level AA, and we check
        every page against them each time the site changes.
      </p>
    </TextSection>

    <TextSection title="What we have done">
      <ul class="list-disc space-y-2 pl-5 marker:text-gold">
        <li>Text and controls have strong contrast against the background.</li>
        <li>
          Everything works from the keyboard, with a visible focus outline and a “skip to main
          content” link.
        </li>
        <li>Pages adapt to any screen size and to enlarged text.</li>
        <li>If you ask your device to reduce motion, the site’s animations are turned off.</li>
        <li>Photographs have text descriptions, and pages use clear headings and landmarks.</li>
        <li>Every change is tested automatically for accessibility and checked by keyboard.</li>
      </ul>
    </TextSection>

    <TextSection title="Known limitations">
      <p>
        Recorded messages are hosted on YouTube. Automatic captions are available there, but they
        may contain errors. The 2026 conference brochure is a PDF that may not be fully accessible —
        we are glad to provide its information in another format.
      </p>
    </TextSection>

    <TextSection title="Tell us about a problem">
      <p>
        If anything on this site is difficult to use, please tell us and we will do our best to put
        it right:{' '}
        <a href={`mailto:${settings.email}`} class="text-link">
          {settings.email}
        </a>{' '}
        or{' '}
        <a href={telHref(settings.phone)} class="text-link whitespace-nowrap">
          {settings.phone}
        </a>
        .
      </p>
    </TextSection>
  </div>
</BaseLayout>
